<Project>
  <PropertyGroup Condition="'$(NativeSDKKind)' != ''">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NativePackageRuntimePattern Condition="'$(NativePackageRoot)' != ''">$(NativePackageRoot)/$(NativeSDKKind)/**/*</NativePackageRuntimePattern>
    <NativePackageRuntimePattern Condition="'$(SdkNativeRuntimeAssets)' != ''">$(SdkNativeRuntimeAssets)/**/*</NativePackageRuntimePattern>
    <IsPackable Condition="'$(NativePackageRuntimePattern)' != ''">true</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(NativePackageRuntimePattern)' != ''">
    <NativePackageRuntime Include="$(NativePackageRuntimePattern)" />
    <None Include="@(NativePackageRuntime)" Pack="true" PackagePath="runtimes/" />
    <None Include="$(MSBuildThisFileDirectory)../../ThirdParty/**/*" Exclude="$(MSBuildThisFileDirectory)../../ThirdParty/**/.DS_Store;$(MSBuildThisFileDirectory)../../ThirdParty/**/registry-notices.json" Pack="true" PackagePath="licenses/" />
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="licenses/" />
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Condition="'$(SdkNativeRuntimeAssets)' != ''" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="RequireNativeCandidates" BeforeTargets="GenerateNuspec" Condition="'$(NativeSDKKind)' != '' And '$(IsPackable)' == 'true'">
    <Error Condition="'@(NativePackageRuntime)' == ''" Text="Run the NuGet pack command from the README with verified native runtimes." />
  </Target>
</Project>
